{
  "expo": {
    "name": "JG App",
    "slug": "jg-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f0f0f",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#0f0f0f",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.jonigontijo.jgapp",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID para entrar mais rápido"
      }
    },
    "android": {
      "package": "com.jonigontijo.jgapp",
      "adaptiveIcon": {
        "backgroundColor": "#0f0f0f",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "themeColor": "#0f0f0f",
      "backgroundColor": "#0f0f0f"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-local-authentication",
      "expo-secure-store"
    ],
    "scheme": "jgapp",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d693a2be-1781-4ee3-9304-12fb0e362487"
      }
    },
    "owner": "yurilinsofc"
  }
}
